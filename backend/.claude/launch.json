{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "genai",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd genai-service && ./.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "backend",
      "runtimeExecutable": "./mvnw",
      "runtimeArgs": [
        "spring-boot:run",
        "-Dspring-boot.run.profiles=dev"
      ],
      "port": 8080
    }
  ]
}
