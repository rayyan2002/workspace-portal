{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "genai",
      "runtimeExecutable": "genai-service/.venv/bin/uvicorn",
      "runtimeArgs": [
        "app.main:app",
        "--app-dir",
        "genai-service",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "backend",
      "runtimeExecutable": "./mvnw",
      "runtimeArgs": [
        "spring-boot:run",
        "-Dspring-boot.run.profiles=dev"
      ],
      "port": 8080
    }
  ]
}
