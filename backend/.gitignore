## mac
.DS_Store

# Secrets. The GenAI service reads genai-service/.env via pydantic-settings
# (env_prefix="GENAI_"), so an API key lives there. A key committed once is in the history
# forever and rotating it is the only fix — ignore the file before it is ever created.
.env
*.env
!test.env

# Day 17: orphaned upload files quarantined out of uploads/ pending deletion.
# They matched no documents row; see BACKLOG item 15.
uploads-orphans-quarantine/

# Day 18: the GenAI service writes rotating logs here (app.log, answers.jsonl).
# answers.jsonl carries no document text, question or answer — see app/observability.py
# and tests/test_log_redaction.py — but it is still operational data, not source.
logs/
genai-service/logs/
